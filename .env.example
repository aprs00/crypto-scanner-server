SECRET_KEY=
POSTGRES_NAME=
POSTGRES_USER=
POSTGRES_PASSWORD=
DJANGO_ALLOWED_HOSTS=
DEBUG=
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_TRUST_PROXY_SSL_HEADER=false
POSTGRES_PORT=
POSTGRES_HOST=
MODE=
STORE_TO_DB=

# ClickHouse stores the one canonical execution tape and compressed tick/TRev
# bar caches. PostgreSQL stores only markets, series metadata, and checkpoints.
CLICKHOUSE_DATABASE=footprints
CLICKHOUSE_USER=footprints
# Required; use a strong, unique value outside local development.
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_HOST_PORT=8123
CLICKHOUSE_SECURE=false
