<clickhouse>
    <!-- Keep operational diagnostics useful without allowing them to grow forever. -->
    <logger>
        <level>warning</level>
    </logger>

    <query_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </query_log>
    <trace_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </trace_log>
    <part_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </part_log>
    <text_log>
        <level>warning</level>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </text_log>
    <metric_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </metric_log>
    <error_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </error_log>
    <query_metric_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </query_metric_log>
    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </asynchronous_metric_log>
    <processors_profile_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </processors_profile_log>
    <asynchronous_insert_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </asynchronous_insert_log>
    <background_schedule_pool_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </background_schedule_pool_log>
</clickhouse>
